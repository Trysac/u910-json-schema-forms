{
  "name": "@trysac/json-schema-forms",
  "version": "0.0.0",
  "description": "Accessible HTML forms generated from a JSON Schema 2020-12 subset, with if/then/else visibility and a hand-written validator with JSON Pointer errors",
  "license": "MIT",
  "author": "Miguel Gomez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trysac/u910-json-schema-forms.git"
  },
  "homepage": "https://github.com/Trysac/u910-json-schema-forms#readme",
  "bugs": {
    "url": "https://github.com/Trysac/u910-json-schema-forms/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
