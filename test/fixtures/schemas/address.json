{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "street": { "type": "string" },
    "country": { "type": "string", "enum": ["US", "CA"] }
  },
  "required": ["country"],
  "if": {
    "properties": {
      "country": { "const": "US" }
    }
  },
  "then": {
    "properties": {
      "zip": { "type": "string", "pattern": "^[0-9]{5}$" }
    },
    "required": ["zip"]
  },
  "else": {
    "properties": {
      "postcode": { "type": "string" }
    }
  }
}
